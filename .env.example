# --- OWS v3 (goszakup.gov.kz) ---
OWS_TOKEN=
OWS_BASE_URL=https://ows.goszakup.gov.kz

# --- PostgreSQL ---
POSTGRES_USER=goszakup
POSTGRES_PASSWORD=goszakup
POSTGRES_DB=goszakup
POSTGRES_PORT=5433
DATABASE_URL=postgresql://goszakup:goszakup@localhost:5433/goszakup
# read-only роль для SQL-инструмента агента (создаётся ETL)
AGENT_RO_PASSWORD=agent_ro_change_me

# --- LLM ---
# anthropic | openai_compat
# openai_compat = Ollama / vLLM (on-prem) или облачный OpenAI-совместимый API:
#   Gemini: OPENAI_COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_COMPAT_MODEL=gemini-3.8-flash
#   OpenAI: https://api.openai.com/v1      Groq: https://api.groq.com/openai/v1
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_MODEL=qwen2.5:7b-instruct
# пусто → temperature не передаётся (нужно для reasoning-моделей)
OPENAI_COMPAT_TEMPERATURE=0
OPENAI_COMPAT_MAX_RETRIES=6

# --- API ---
# разрешённые источники для браузера (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
